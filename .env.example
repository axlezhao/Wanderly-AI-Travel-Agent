# Copy this file to .env and fill in any keys you have. All are optional:
# with no keys the app runs in "Demo" mode (rule-based, same tools).
# You can also add models (any provider) from the ⚙ Models button in the UI.

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=medium

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro

# Any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Ollama…)
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Harness / server
# HARNESS=react       # or langgraph: the same ReAct loop as a LangGraph graph
# MCP_SERVER=node     # or go: the Go implementation of the tool server (npm run start:go builds it)
# MAX_STEPS=6
# PORT=3000
# HOME_CURRENCY=USD   # demo mode converts from this currency
